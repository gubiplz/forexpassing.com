{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/regulamin", "destination": "/terms", "permanent": true },
    { "source": "/polityka-prywatnosci", "destination": "/privacy", "permanent": true },
    { "source": "/affiliate", "destination": "/partner-portal", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/r/:slug"
    },
    {
      "source": "/pay/:token",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/pay/:token",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [
    {
      "path": "/api/spots-ping",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/site-rebuild",
      "schedule": "15 6 * * 1"
    }
  ]
}

      "destination": "/"
    },
    {
      "source": "/tiktok-funnel",
      "destination": "/"
    },
    {
      "source": "/payouts",
      "destination": "/"
    },
    {
      "source": "/past-performance",
      "destination": "/"
    },
    {
      "source": "/reviews",
      "destination": "/"
    },
    {
      "source": "/contract",
      "destination": "/"
    },
    {
      "source": "/referral-program",
      "destination": "/"
    },
    {
      "source": "/partner-portal",
      "destination": "/"
    },
    {
      "source": "/thank-you",
      "destination": "/"
    }
  ]

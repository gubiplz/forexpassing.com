{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/meta", "destination": "/index.html" },
    { "source": "/meta-funnel", "destination": "/index.html" },
    { "source": "/insta-funnel", "destination": "/index.html" },
    { "source": "/google-funnel", "destination": "/index.html" },
    { "source": "/tiktok-funnel", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/ai-risk-officer-system-b1f7c6503b8c.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"AI-Risk-Officer-System.pdf\""
        }
      ]
    }
  ]
}
